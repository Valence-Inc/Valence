# ─── Postgres ───────────────────────────────────────────────
DATABASE_URL=postgresql://oja:oja@localhost:5433/oja

# ─── Stellar Testnet ────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract addresses (filled by scripts/deploy.sh)
ESCROW_CONTRACT_ID=
REPUTATION_CONTRACT_ID=
# Native XLM wrapper or custom SAC token address
TOKEN_CONTRACT_ID=

# Deployer / arbiter account (filled by scripts/fund-accounts.sh)
STELLAR_SECRET_KEY=
STELLAR_PUBLIC_KEY=

# ─── NVIDIA NIM (orchestrator LLM calls) ───────────────────
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet

